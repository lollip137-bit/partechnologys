# PAR Technologys — static site on Hostinger (LiteSpeed / Apache)
# Uploaded to the site root by the deploy workflow. Controls caching so a new
# deploy shows immediately, while build assets stay fast.

<IfModule mod_headers.c>
  # HTML pages: always revalidate — a new deploy is visible at once, no purge
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Next.js build assets are content-hashed (the filename changes every build),
  # so they can be cached forever and never go stale
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # media — cache a week, then revalidate
  <FilesMatch "\.(mp4|webm|jpe?g|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# branded not-found page
ErrorDocument 404 /404.html
